<% layout("/layouts/boilerplate") %>

<style>
    .grid-container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 2.5rem 2rem;
    }
    
    .page-title {
      font-size: 1.9rem;
      font-weight: 600;
      margin-bottom: 2rem;
    }
    
    .listing-card {
      border: none;
      padding: 0.5rem;
      border-radius: 18px;
      overflow: hidden;
      transition: 0.25s ease;
    }
    
    .listing-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 35px rgba(0,0,0,0.12);
    }
    
    .listing-card img {
      height: 230px;
      object-fit: cover;
      border-radius: 18px;
    }
    
    .card-body {
      padding: 0.7rem 0.3rem 0.2rem 0.3rem;
    }
    
    .card-title {
      font-size: 1rem;
      font-weight: 600;
      margin-top: 0.3rem;
      margin-bottom: 0.3rem;
    }
    
    .card-text {
      font-size: 0.9rem;
      font-weight: 500;
      color: #555;
    }
    
    .listing-link {
      text-decoration: none;
      color: inherit;
    }
    
    /* ================= DESKTOP GRID SPACING ================= */
    .custom-grid {
      row-gap: 2rem;
    }
    
    /* ================= MOBILE FIX ================= */
    @media (max-width: 768px) {
    
      .grid-container {
        padding: 1.2rem 1rem;
      }
    
      .page-title {
        font-size: 1.5rem;
        margin-bottom: 1.2rem;
      }
    
      .listing-card img {
        height: 190px;
      }

      .listing-card {
      padding: 0rem;
    }
    
      .custom-grid {
        row-gap: 1.2rem; /* reduce vertical space */
      }
    
      .col-sm-6,
      .col-md-4,
      .col-lg-3 {
        padding-left: 8px;
        padding-right: 8px;
      }
    }
    
    @media (max-width: 576px) {
    
      .listing-card img {
        height: 170px;
      }
    
      .custom-grid {
        row-gap: 1rem; /* tighter spacing */
      }
    }
    </style>

<div class="grid-container">

  <div class="page-title">
    <%= title %>
  </div>

  <div class="row custom-grid">

    <% listings.forEach(listing => { %>

      <div class="col-lg-3 col-md-4 col-sm-6">

        <a href="/listings/<%= listing._id %>" class="listing-link">

        <div class="card listing-card h-80">

            <img src="<%= listing.image.url %>" class="card-img-top">

            <div class="card-body">
              <div class="card-title">
                <%= listing.title %>
              </div>

              <div class="card-text">
                ₹ <%= listing.price.toLocaleString("en-IN") %> / night
              </div>
            </div>

        </div>

        </a>

      </div>

    <% }) %>

  </div>

</div>