<% layout("/layouts/boilerplate") %>

<style>
body {
  background-color: #f7f7f7;
}

/* ================= SEARCH BAR ================= */
.search-section {
  display: flex;
  justify-content: center;
  margin: 2rem 0 1.5rem 0;
}

.search-box {
  width: 50%;
  display: flex;
  background: white;
  border-radius: 50px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  overflow: hidden;
}

.search-box input {
  flex: 1;
  border: none;
  padding: 1rem 1.6rem;
  font-size: 0.95rem;
  outline: none;
}

.search-box button {
  background: #ff385c;
  border: none;
  padding: 0 2rem;
  color: white;
  font-weight: 600;
}
.search-box button:hover {
  background: #ff4466;
}

/* ================= SECTION TITLE ================= */
.section-wrapper {
  padding: 0 2rem;
}

.section-title {
  font-size: 1.4rem;
  font-weight: 600;
  margin-bottom: 1.2rem;
  margin-top: 1rem;
}

/* ================= HORIZONTAL SCROLL ================= */
.horizontal-scroll {
  display: flex;
  gap: 1.3rem;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding-bottom: 1rem;
}

.horizontal-scroll::-webkit-scrollbar {
  display: none;
}

/* ================= CARD ================= */
.listing-card {
  min-width: 270px;      /* smaller than before */
  min-height: 280px;
  max-width: 270px;
  padding: 0.5rem;
  border-radius: 18px;
  overflow: hidden;
  background: white;
  transition: 0.25s ease;
}

.listing-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 30px rgba(0,0,0,0.12);
}

.card-img-wrapper {
  position: relative;
}

.card-img-wrapper img {
  width: 100%;
  height: 190px;
  object-fit: cover;
  border-radius: 18px;
}

/* Wishlist */
.wishlist {
  position: absolute;
  top: 10px;
  right: 10px;
  background: white;
  padding: 6px 8px;
  border-radius: 50%;
  font-size: 0.85rem;
  box-shadow: 0 3px 8px rgba(0,0,0,0.15);
}

/* CARD BODY (FIXED PROPER PADDING) */
.card-body {
  padding: 0.6rem 0.3rem 0.2rem 0.3rem;
}

.card-title {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 0.3rem;
}

.card-price {
  font-size: 0.9rem;
  font-weight: 500;
  color: #555;
}

.listing-link {
  text-decoration: none;
  color: inherit;
}

.section-title {
  font-size: 1.4rem;
  font-weight: 600;
  margin-bottom: 1rem;
  margin-top: 2.5rem;
}

.section-title a {
  color: #ff385c;
  transition: 0.2s ease;
}

.section-title a:hover {
  opacity: 0.7;
}

/* RESPONSIVE */
@media(max-width:768px){
  .search-box {
    width: 90%;
  }

  .section-wrapper {
    padding: 0 1rem;
  }

  .listing-card {
    min-width: 240px;
    max-width: 240px;
  }

  .card-img-wrapper img {
    height: 170px;
  }
}
</style>

<body>

  <!-- SEARCH -->
  <div class="search-section">
    <form class="search-box" action="/listings" method="GET">
      <input type="text" name="search" placeholder="Search destinations..." />
      <button type="submit">Search</button>
    </form>
  </div>

  <!-- SECTION -->
  <div class="section-wrapper">

    <% groupedListings.forEach(group => { %>

      <div class="section-title d-flex justify-content-between align-items-center">
        <span>Stays in <%= group._id %></span>
    
        <a href="/listings/state/<%= group._id %>" 
           style="font-size: 0.9rem; text-decoration: none; font-weight: 500;">
           Show All
        </a>
      </div>
    
      <div class="horizontal-scroll">
    
        <% group.listings.forEach(listing => { %>
    
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="listing-card">
    
              <div class="card-img-wrapper">
                <img src="<%= listing.image.url %>" alt="">
                <!-- <div class="wishlist">
                  <i class="fa-regular fa-heart"></i>
                </div> -->
              </div>
    
              <div class="card-body">
                <div class="card-title">
                  <%= listing.title %>
                </div>
    
                <div class="card-price">
                  ₹ <%= listing.price.toLocaleString("en-IN") %> / night
                </div>
              </div>
    
            </div>
          </a>
    
        <% }) %>
    
      </div>
    
    <% }) %>

  </div>

</body>