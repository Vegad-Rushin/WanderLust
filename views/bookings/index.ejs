<% layout("/layouts/boilerplate") %>

<style>
  body {
    margin: 0;
    font-family: "Poppins", sans-serif;
    background: #f7f7f7;
  }

  /* ================= CONTAINER ================= */
  .container {
    max-width: 900px;
    margin: 30px auto;
    padding: 0 16px;
  }

  /* ================= TITLE ================= */
  .title {
    font-size: 26px;
    font-weight: 600;
    margin-bottom: 25px;
  }

  /* ================= SECTION ================= */
  .section-title {
    font-size: 18px;
    font-weight: 600;
    margin: 20px 0 12px;
  }

  /* ================= CARD ================= */
  .booking-card {
    display: flex;
    gap: 16px;
    background: white;
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 16px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    transition: 0.25s ease;
  }

  .booking-card:hover {
    transform: translateY(-2px);
  }

  /* IMAGE */
  .booking-card img {
    width: 150px;
    height: 100px;
    object-fit: cover;
    border-radius: 10px;
  }

  /* INFO */
  .booking-info {
    flex: 1;
  }

  .booking-info h4 {
    margin: 0;
    font-size: 16px;
  }

  .booking-info p {
    margin: 4px 0;
    font-size: 13px;
    color: #555;
  }

  /* PRICE */
  .price {
    font-weight: 600;
    font-size: 14px;
  }

  /* STATUS */
  .status {
    display: inline-block;
    background: #d4f3e1;
    color: #1f7a4c;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    margin-top: 6px;
  }

  /* LINKS */
  .listing-link {
    text-decoration: none;
    color: inherit;
  }

  /* EMPTY */
  .no-booking {
    font-size: 14px;
    color: #777;
  }

  .booking-card:active {
    transform: scale(0.98);
  }

  /* ================= MOBILE ================= */
  @media (max-width: 768px) {
    .container {
      margin: 20px auto;
    }

    .title {
      font-size: 22px;
    }

    /* STACK CARD */
    .booking-card {
      flex-direction: column;
      padding: 12px;
    }

    .booking-card img {
      width: 100%;
      height: 160px;
    }

    .booking-info h4 {
      font-size: 15px;
    }

    .booking-info p {
      font-size: 12px;
    }

    .price {
      font-size: 13px;
    }

    .status {
      font-size: 10px;
    }
  }

  @media (min-width: 1024px) {

/* BIGGER CONTAINER */
.container {
  max-width: 1100px;
}

/* BIGGER CARD */
.booking-card {
  padding: 20px;
  gap: 22px;
  border-radius: 20px;
}

/* BIGGER IMAGE */
.booking-card img {
  width: 200px;
  height: 130px;
  border-radius: 14px;
}

/* BIGGER TEXT */
.booking-info h4 {
  font-size: 18px;
}

.booking-info p {
  font-size: 14px;
}

.price {
  font-size: 15px;
}

/* SECTION TITLES */
.title {
  font-size: 30px;
}

.section-title {
  font-size: 22px;
}
}
</style>

<div class="container">
  <h2 class="title">My Bookings</h2>

  <!-- ================= UPCOMING BOOKINGS ================= -->

  <h3 class="section-title">Upcoming Trips</h3>

  <% if(upcomingBookings.length === 0){ %>

  <p class="no-booking">No upcoming trips.</p>

  <% } %> <% upcomingBookings.forEach(booking => { %>

  <a href="/listings/<%= booking.listing._id %>" class="listing-link">
    <div class="booking-card">
      <img src="<%= booking.listing.image.url %>" />

      <div class="booking-info">
        <h4><%= booking.listing.title %></h4>

        <p>
          📍 <%= booking.listing.location.city %>, <%=
          booking.listing.location.state %>
        </p>

        <p>
          📅 <%= booking.checkIn.toDateString() %> – <%=
          booking.checkOut.toDateString() %>
        </p>

        <p>👥 <%= booking.guests %> Guests</p>

        <p class="price">
          Total Paid: ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>
        </p>

        <span class="status">Upcoming</span>
      </div>
    </div>
  </a>

  <% }) %>

  <!-- ================= PAST BOOKINGS ================= -->

  <h3 class="section-title">Past Trips</h3>

  <% if(pastBookings.length === 0){ %>

  <p class="no-booking">No past trips.</p>

  <% } %> <% pastBookings.forEach(booking => { %>

  <div class="booking-card">
    <img src="<%= booking.listing.image.url %>" />

    <div class="booking-info">
      <h4><%= booking.listing.title %></h4>

      <p>
        📍 <%= booking.listing.location.city %>, <%=
        booking.listing.location.state %>
      </p>

      <p>
        📅 <%= booking.checkIn.toDateString() %> – <%=
        booking.checkOut.toDateString() %>
      </p>

      <p>👥 <%= booking.guests %> Guests</p>

      <p class="price">
        Total Paid: ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>
      </p>

      <span class="status" style="background: #eee; color: #666"
        >Completed</span
      >
    </div>
  </div>

  <% }) %>
</div>
