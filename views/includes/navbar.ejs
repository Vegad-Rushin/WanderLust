<style>
  /* ================= NAVBAR ================= */
  .navbar {
    background: #fff;
    padding: 0.7rem 2rem;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
    position: relative;
  }

  .container-fluid {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ================= LEFT ================= */
  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .navbar-brand {
    font-size: 1.6rem;
    color: #ff385c;
  }

  .nav-link {
    color: #222;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link:hover {
    color: #ff385c;
  }

  .icon {
    color: #ff385c;
    margin-right: 0.15rem;
  }

  /* ================= CENTER ================= */
  .nav-center {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .category-menu {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .category-item {
    text-align: center;
    text-decoration: none;
    opacity: 0.75;
    transition: 0.2s ease;
  }

  .category-item img {
    width: 26px;
    height: 26px;
  }

  .category-item span {
    font-size: 0.8rem;
    font-weight: 600;
    color: #222;
  }

  .category-item:hover {
    opacity: 1;
    scale: 1.1;
    transition: 0.2s ease;
  }

  /* ================= RIGHT ================= */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* DESKTOP MENU */
  .desktop-menu {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  /* HAMBURGER */
  .hamburger {
    display: none;
    font-size: 1.4rem;
    cursor: pointer;
  }

  /* ================= MOBILE MENU ================= */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: #fff;
    position: absolute;
    top: 65px;
    right: 10px;
    width: 220px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    padding: 10px;
    z-index: 100;
  }

  .mobile-menu a {
    padding: 10px;
    text-decoration: none;
    color: #222;
    border-radius: 8px;
  }

  .mobile-menu a:hover {
    background: #f7f7f7;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 768px) {
    .navbar {
      padding: 0.6rem 0.3rem;
    }

    .icon {
      margin-right: 0.4rem;
    }

    /* HIDE EXPLORE */
    .nav-left .nav-link {
      display: none;
    }

    /* SHOW HAMBURGER */
    .hamburger {
      display: block;
    }

    /* HIDE DESKTOP MENU */
    .desktop-menu {
      display: none;
    }

    /* CENTER ITEMS */
    .nav-center {
      display: flex;
      justify-content: center;
    }

    .category-menu {
      gap: 1.2rem;
    }

    .category-item img {
      width: 24px;
      height: 24px;
    }

    .category-item span {
      font-size: 0.8rem;
      font-weight: 600;
      color: #222;
    }
  }
</style>

<style>
  /* ================= MODAL ================= */
  .modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .modal-content {
    background-color: #fff;
    margin: 8% auto;
    padding: 30px 25px;
    border-radius: 16px;
    width: 90%;
    max-width: 400px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    position: relative;
    font-family: 'Arial', sans-serif;
  }

  .close-modal {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 1.4rem;
    cursor: pointer;
    color: #888;
    transition: 0.2s;
  }

  .close-modal:hover {
    color: #ff385c;
  }

  .modal h3 {
    text-align: center;
    color: #222;
    margin-bottom: 20px;
  }

  .modal form input {
    width: 100%;
    padding: 12px 15px;
    margin: 10px 0;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 0.95rem;
    transition: 0.2s;
  }

  .modal form input:focus {
    border-color: #ff385c;
    outline: none;
  }

  .modal form button {
    width: 100%;
    padding: 12px;
    background-color: #ff385c;
    border: none;
    border-radius: 10px;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    font-size: 1rem;
    margin-top: 15px;
    transition: 0.2s;
  }

  .modal form button:hover {
    background-color: #e0294d;
  }
</style>

<nav class="navbar sticky-top">
  <div class="container-fluid">
    <!-- LEFT -->
    <div class="nav-left">
      <a class="navbar-brand" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>

      <!-- Hidden on mobile -->
      <a class="nav-link" href="/listings">Explore</a>
    </div>

    <!-- CENTER -->
    <div class="nav-center">
      <div class="category-menu">
        <a href="/listings/category/Homes" class="category-item">
          <img src="https://cdn-icons-png.flaticon.com/512/69/69524.png" />
          <span>Homes</span>
        </a>

        <a href="/listings/category/Villas" class="category-item">
          <img src="https://cdn-icons-png.flaticon.com/512/619/619153.png" />
          <span>Villas</span>
        </a>

        <a href="/listings/category/Resorts" class="category-item">
          <img src="https://cdn-icons-png.flaticon.com/512/854/854878.png" />
          <span>Resorts</span>
        </a>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="nav-right">
      <!-- DESKTOP MENU -->
      <div class="desktop-menu">
        <% if (!currUser) { %>
        <!-- <button class="border-0 bg-transparent">Log in</button>
        <button class="border-0 bg-transparent">Sign up</button> -->
        <button class="openLogin border-0 bg-transparent">Log in</button>
        <button class="openSignup border-0 bg-transparent">Sign up</button>
        <% } else { %>
        <!-- <a class="nav-link" href="/listings/new">Airbnb your home</a> -->
        <a href="/bookings" class="nav-link">
          <i class="fa-solid fa-suitcase-rolling icon"></i> My Trips
        </a>
        <a class="nav-link fw-bold " href="/profile">
          <i class="fa-solid fa-circle-user icon"></i>
          Profile
        </a>
        <a class="nav-link" href="/logout">
          <i class="fa-solid fa-right-from-bracket icon"></i>
          Log out
        </a>
        <% } %>
      </div>

      <!-- HAMBURGER -->
      <div class="hamburger" id="menuToggle">
        <i class="fa-solid fa-bars"></i>
      </div>
    </div>
  </div>

  <!-- MOBILE DROPDOWN -->
  <div class="mobile-menu" id="mobileMenu">
    <% if (!currUser) { %>
    <button class="openLogin border-0 bg-transparent">Log in</button>
    <button class="openSignup border-0 bg-transparent">Sign up</button>
    <% } else { %>
    <a href="/listings/new"><i class="fa-solid fa-house-chimney icon"></i>Airbnb your home</a>
    <a href="/bookings"
      ><i class="fa-solid fa-suitcase-rolling icon"></i> My Trips</a
    >
    <a href="/profile"><i class="fa-solid fa-circle-user icon"></i>Profile</a>
    <a href="/logout"><i class="fa-solid fa-right-from-bracket icon"></i>Log out</a>
    <% } %>
  </div>
</nav>

<!-- LOGIN MODAL -->
<div id="loginModal" class="modal">
  <div class="modal-content">
    <span class="close-modal" id="closeLogin">&times;</span>
    <h3>Welcome Back</h3>
    <form action="/login" method="POST">
      <input type="text" name="username" placeholder="Username" required />
      <input type="password" name="password" placeholder="Password" required />
      <button type="submit">Log In</button>
    </form>
    <p style="text-align:center; margin-top: 10px; font-size:0.9rem;">
      Don't have an account?
      <span style="color:#ff385c; cursor:pointer;" id="openSignupFromLogin">Sign up</span>
    </p>
  </div>
</div>

<!-- SIGNUP MODAL -->
<div id="signupModal" class="modal">
  <div class="modal-content">
    <span class="close-modal" id="closeSignup">&times;</span>
    <h3>Create Your Account</h3>
    <form action="/signup" method="POST">
      <input type="text" name="username" placeholder="Username" required />
      <input type="email" name="email" placeholder="Email" required />
      <input type="password" name="password" placeholder="Password" required />
      <button type="submit">Sign Up</button>
    </form>
    <p style="text-align:center; margin-top: 10px; font-size:0.9rem;">
      Already have an account?
      <span style="color:#ff385c; cursor:pointer;" id="openLoginFromSignup">Sign in</span>
    </p>
  </div>
</div>


<script>
  // ================= MODAL SCRIPT =================
  const loginModal = document.getElementById("loginModal");
  const signupModal = document.getElementById("signupModal");
  const closeLogin = document.getElementById("closeLogin");
  const closeSignup = document.getElementById("closeSignup");

  function showLoginModal() {
    loginModal.style.display = "block";
    signupModal.style.display = "none"; // hide signup if open
    mobileMenu.style.display = "none"; // hide mobile menu if open
  }

  function showSignupModal() {
    signupModal.style.display = "block";
    loginModal.style.display = "none"; // hide login if open
    mobileMenu.style.display = "none"; // hide mobile menu if open
  }

  closeLogin.onclick = () => loginModal.style.display = "none";
  closeSignup.onclick = () => signupModal.style.display = "none";

  window.onclick = (e) => {
    if (e.target === loginModal) loginModal.style.display = "none";
    if (e.target === signupModal) signupModal.style.display = "none";
  }

  // Buttons inside modals for switching
  const openLoginFromSignup = document.getElementById("openLoginFromSignup");
  const openSignupFromLogin = document.getElementById("openSignupFromLogin");

  openLoginFromSignup.onclick = showLoginModal;
  openSignupFromLogin.onclick = showSignupModal;

  // Navbar buttons (desktop + mobile)
  document.querySelectorAll(".openLogin").forEach(btn => {
    btn.addEventListener("click", showLoginModal);
  });
  document.querySelectorAll(".openSignup").forEach(btn => {
    btn.addEventListener("click", showSignupModal);
  });

  // ================= MOBILE MENU (HAMBURGER) =================
  const toggle = document.getElementById("menuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  toggle.addEventListener("click", () => {
    // Toggle display between flex and none
    if (mobileMenu.style.display === "flex") {
      mobileMenu.style.display = "none";
    } else {
      mobileMenu.style.display = "flex";
      mobileMenu.style.flexDirection = "column";
    }
  });

  // Close mobile menu when clicking login/signup
  document.querySelectorAll(".mobile-menu .openLogin").forEach(btn => {
    btn.addEventListener("click", () => mobileMenu.style.display = "none");
  });
  document.querySelectorAll(".mobile-menu .openSignup").forEach(btn => {
    btn.addEventListener("click", () => mobileMenu.style.display = "none");
  });
</script>