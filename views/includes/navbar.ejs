<style>
  /* ================= NAVBAR ================= */
  .navbar {
    background: #fff;
    padding: 0.7rem 2rem;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
    position: relative;
  }

  .container-fluid {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ================= LEFT ================= */
  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .navbar-brand {
    font-size: 1.6rem;
    color: #ff385c;
  }

  .nav-link {
    color: #222;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link:hover {
    color: #ff385c;
  }

  .fa-suitcase-rolling {
    color: #ff385c;
  }

  /* ================= CENTER ================= */
  .nav-center {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .category-menu {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .category-item {
    text-align: center;
    text-decoration: none;
    opacity: 0.75;
    transition: 0.2s ease;
  }

  .category-item img {
    width: 26px;
    height: 26px;
  }

  .category-item span {
    font-size: 0.8rem;
    font-weight: 600;
    color: #222;
  }

  .category-item:hover {
    opacity: 1;
    scale: 1.1;
    transition: 0.2s ease;
  }

  /* ================= RIGHT ================= */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* DESKTOP MENU */
  .desktop-menu {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  /* HAMBURGER */
  .hamburger {
    display: none;
    font-size: 1.4rem;
    cursor: pointer;
  }

  /* ================= MOBILE MENU ================= */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: #fff;
    position: absolute;
    top: 65px;
    right: 10px;
    width: 220px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    padding: 10px;
    z-index: 100;
  }

  .mobile-menu a {
    padding: 10px;
    text-decoration: none;
    color: #222;
    border-radius: 8px;
  }

  .mobile-menu a:hover {
    background: #f7f7f7;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 768px) {
    .navbar {
      padding: 0.6rem 0.3rem;
    }

    /* HIDE EXPLORE */
    .nav-left .nav-link {
      display: none;
    }

    /* SHOW HAMBURGER */
    .hamburger {
      display: block;
    }

    /* HIDE DESKTOP MENU */
    .desktop-menu {
      display: none;
    }

    /* CENTER ITEMS */
    .nav-center {
      display: flex;
      justify-content: center;
    }

    .category-menu {
      gap: 1.2rem;
    }

    .category-item img {
    width: 24px;
    height: 24px;
  }

  .category-item span {
    font-size: 0.8rem;
    font-weight: 600;
    color: #222;
  }

  }
</style>

<nav class="navbar sticky-top">
  <div class="container-fluid">
    <!-- LEFT -->
    <div class="nav-left">
      <a class="navbar-brand" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>

      <!-- Hidden on mobile -->
      <a class="nav-link" href="/listings">Explore</a>
    </div>

    <!-- CENTER -->
    <div class="nav-center">
      <div class="category-menu">
        <a href="/listings/category/Homes" class="category-item">
          <img src="https://cdn-icons-png.flaticon.com/512/69/69524.png" />
          <span>Homes</span>
        </a>

        <a href="/listings/category/Villas" class="category-item">
          <img src="https://cdn-icons-png.flaticon.com/512/619/619153.png" />
          <span>Villas</span>
        </a>

        <a href="/listings/category/Resorts" class="category-item">
          <img src="https://cdn-icons-png.flaticon.com/512/854/854878.png" />
          <span>Resorts</span>
        </a>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="nav-right">
      <!-- DESKTOP MENU -->
      <div class="desktop-menu">
        <% if (!currUser) { %>
        <button class="border-0 bg-transparent">Log in</button>
        <button class="border-0 bg-transparent">Sign up</button>
        <% } else { %>
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <a class="nav-link fw-bold" href="/profile"><%= currUser.username %></a>
        <a href="/bookings" class="nav-link">
          <i class="fa-solid fa-suitcase-rolling"></i> My Trips
        </a>
        <a class="nav-link" href="/logout">Log out</a>
        <% } %>
      </div>

      <!-- HAMBURGER -->
      <div class="hamburger" id="menuToggle">
        <i class="fa-solid fa-bars"></i>
      </div>
    </div>
  </div>

  <!-- MOBILE DROPDOWN -->
  <div class="mobile-menu" id="mobileMenu">
    <% if (!currUser) { %>
    <a href="#">Log in</a>
    <a href="#">Sign up</a>
    <% } else { %>
    <a href="/listings/new">Airbnb your home</a>
    <a href="/bookings"
      ><i class="fa-solid fa-suitcase-rolling"></i> My Trips</a
    >
    <a href="/profile"><%= currUser.username %></a>
    <a href="/logout">Log out</a>
    <% } %>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menuToggle");
  const menu = document.getElementById("mobileMenu");

  toggle.addEventListener("click", () => {
    menu.style.display = menu.style.display === "flex" ? "none" : "flex";
  });
</script>
